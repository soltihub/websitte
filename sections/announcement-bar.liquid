{% assign announcement_text = section.settings.text %}
<div class="announcement-bar">
  <div class="container">
    <div class="announcement-text">
      {{ announcement_text }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "UAE delivery in 1–2 business days • Cash on delivery available"
    }
  ]
}
{% endschema %}
