<section class="section" id="faq">
  <div class="container">
    <div class="section-head">
      <h2>Frequently asked questions</h2>
    </div>

    <div class="faq-wrap">
      <div class="faq-item open">
        <button class="faq-q" type="button">
          <span>Do you deliver across the UAE?</span>
          <span>+</span>
        </button>
        <div class="faq-a">
          Yes. We deliver across Dubai, Abu Dhabi, Sharjah, and other emirates subject to courier coverage and local timings.
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-q" type="button">
          <span>Is cash on delivery available?</span>
          <span>+</span>
        </button>
        <div class="faq-a">
          Yes, cash on delivery is available for eligible orders and locations. We will show a delivery notice at checkout.
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-q" type="button">
          <span>How long does delivery take?</span>
          <span>+</span>
        </button>
        <div class="faq-a">
          Most orders are delivered in 1–2 business days within major emirates. Some areas may take slightly longer.
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-q" type="button">
          <span>What if my order arrives damaged?</span>
          <span>+</span>
        </button>
        <div class="faq-a">
          Contact us within 48 hours of delivery and we’ll support a return or replacement based on the product issue.
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": []
}
{% endschema %}
